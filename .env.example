# Copier ce fichier en .env puis renseigner les valeurs.
# Les variables préfixées EXPO_PUBLIC_ sont embarquées dans l'app.

# Supabase : Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# OpenCage (géocodage inverse) : https://opencagedata.com
EXPO_PUBLIC_OPENCAGE_API_KEY=votre-cle-opencage
